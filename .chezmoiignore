# nvim: vim.pack writes this lockfile at runtime. Leave it unmanaged so each
# machine resolves plugins itself (same rationale as dropping mise.lock — avoids
# machine-local drift). Guards against an accidental whole-dir `chezmoi add`.
.config/nvim/nvim-pack-lock.json

