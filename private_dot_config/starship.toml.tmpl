# Starship prompt configuration
# https://starship.rs/config/

# Timeout for commands executed by starship (in milliseconds)
# Default is 500ms which can timeout on large repos
command_timeout = 1000

# Format of the prompt
format = """
${env_var.exedev}\
$username\
$hostname\
$directory\
$git_branch\
$git_commit\
$git_state\
$git_metrics\
$git_status\
$docker_context\
$memory_usage\
$aws\
$gcloud\
$openstack\
$azure\
$env_var\
$cmd_duration\
$time\
$line_break\
$jobs\
$battery\
$status\
$shell\
$character"""

# Wait 30 milliseconds for starship to check files
scan_timeout = 30

# Disable the blank line at the start of the prompt
add_newline = false

[character]
success_symbol = "[➜](bold green)"
error_symbol = "[➜](bold red)"
{{ if eq .chezmoi.username "exedev" }}
# Lightning bolt — emitted only on exe.dev hosts, where chezmoi renders this
# config as the exedev user. Implemented as an env_var module (keyed on the
# always-present $USER) rather than a custom command, so starship shows the
# bolt natively with no shell fork. On every other machine the block is omitted
# entirely, so the prompt never forks for it (and never warns about a timed-out
# custom command).
[env_var.exedev]
variable = "USER"
format = "[⚡]($style) "
style = "bold yellow"
{{ end }}
[directory]
truncation_length = 3
truncate_to_repo = true
format = "[$path]($style)[$read_only]($read_only_style) "
style = "bold cyan"

[git_branch]
format = "[$symbol$branch(:$remote_branch)]($style) "
symbol = " "
style = "bold purple"

[git_status]
format = '([$conflicted](bold red)[$stashed](bright-black)[$staged](green)[$modified](yellow)[$untracked](blue)[$ahead_behind](cyan))'
conflicted = "=${count} "
stashed = "≡${count} "
staged = "●${count} "
modified = "~${count} "
untracked = "󱀶${count} "
deleted = ""
renamed = ""
ahead = "⇡${count} "
behind = "⇣${count} "
diverged = "⇡${ahead_count}⇣${behind_count} "

[status]
disabled = false
format = '[✘ $status]($style) '
style = "bold red"

[git_metrics]
disabled = false
format = '([+$added]($added_style) )([-$deleted]($deleted_style) )'
added_style = "bold green"
deleted_style = "bold red"

[cmd_duration]
min_time = 500
format = "[$duration]($style) "
style = "bold yellow"

[docker_context]
format = "[$symbol$context]($style) "
symbol = "🐳 "

[aws]
disabled = true

[time]
disabled = false
format = '[$time]($style) '
time_format = "%H:%M"
style = "bright-black"

[username]
show_always = false
format = "[$user]($style) "
style_user = "bold yellow"
style_root = "bold red"

[hostname]
ssh_only = true
format = "[$hostname]($style) "
style = "bold green"
{{ if and .isWork .workHostname -}}
aliases = { {{ .workHostname | quote }} = "work-mac" }
{{- else -}}
aliases = {}
{{- end }}