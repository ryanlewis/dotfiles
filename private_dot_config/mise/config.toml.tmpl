# Global mise configuration
# https://mise.jdx.dev/configuration.html
# Updated: August 2026

[tools]
# Core language runtime — always installed; the dotfiles tooling depends on it
# (node/npm for biome + the npm-backend tools).
node = "24.19.0" # LTS (Active LTS until April 2028)
#
# bun is intentionally NOT managed here — it's installed by its official
# installer (run_once_04-install-bun.sh) and self-updates via `bun upgrade`.
#
# Heavy, project-specific runtimes (Go, Java, Python/Miniconda) are opt-in per
# machine and live in conf.d/runtimes.toml (selected once at `chezmoi init`).

# CLI tools via aqua backend (pre-built cross-platform binaries)
# https://mise.jdx.dev/dev-tools/backends/aqua.html
"aqua:junegunn/fzf" = "0.74.2"
"aqua:sharkdp/bat" = "0.26.1"
"aqua:sharkdp/fd" = "10.4.2"
{{ if ne .chezmoi.os "darwin" -}}
"aqua:eza-community/eza" = "0.23.5" # Linux only; macOS uses Homebrew
{{ end -}}
"aqua:BurntSushi/ripgrep" = "15.2.0"
"aqua:ajeetdsouza/zoxide" = "0.10.0"
"aqua:muesli/duf" = "0.9.1"
"aqua:bootandy/dust" = "1.2.4"
"aqua:starship/starship" = "1.26.0"
"aqua:atuinsh/atuin" = "18.18.1"
"aqua:dandavison/delta" = "0.19.2"
"aqua:jesseduffield/lazygit" = "0.63.1"
"aqua:cli/cli" = "2.97.0" # GitHub CLI (gh)
"aqua:casey/just" = "1.57.0"
"aqua:charmbracelet/gum" = "0.17.0"
"aqua:jqlang/jq" = "1.8.2"
"aqua:kubernetes/kubernetes/kubectl" = "1.36.3"
"aqua:ahmetb/kubectx" = "0.11.0"
"aqua:ahmetb/kubectx/kubens" = "0.11.0"
"aqua:astral-sh/uv" = "0.12.1"
"aqua:common-fate/granted" = "0.38.0" # pinned: v0.39.0 missing from releases.commonfate.io
"aqua:neovim/neovim" = "0.12.4" # nvim — modal editor
"aqua:tree-sitter/tree-sitter" = "0.26.11" # nvim-treesitter (main branch) parser compiler
television = "0.15.9" # TUI fuzzy finder (tv)

# CLI tools via npm backend (not in the aqua registry)
# https://mise.jdx.dev/dev-tools/backends/npm.html
{{ if dig "toolHunkdiff" false . -}}
"npm:hunkdiff" = "0.17.7" # `hunk` — diff viewer/pager (~600 MB, opt-in per machine)
{{ end -}}
"npm:cf" = "0.5.0" # Cloudflare CLI

[settings]
# No lockfile: mise.lock is shared with machine-local tools (conf.d/local.toml),
# so a managed/committed lock perpetually drifts against what mise writes here.
# All tools are pinned (2026-08 supply-chain hardening); Renovate bumps them via
# the regex customManagers in renovate.json (the mise TOML manager can't parse
# Go-template files).
lockfile = false

# Opt-in language runtimes (Go/Java/Python) live in the managed
# ~/.config/mise/conf.d/runtimes.toml — gated per machine via `chezmoi init`.
# Machine-local tools (e.g. codex, salesforce sf) live in
# ~/.config/mise/conf.d/local.toml — kept out of this repo on purpose.
