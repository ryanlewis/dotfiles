# Opt-in language runtimes — installed per machine.
#
# Which runtimes land here is chosen once at `chezmoi init` (the prompts default
# to "no", so a fresh machine / VM / CI stays lean). To change the selection
# later: `chezmoi init --prompt` (or edit ~/.config/chezmoi/chezmoi.toml).
#
# mise merges this file on top of ~/.config/mise/config.toml. The version pins
# live here (not in config.toml) so Renovate keeps bumping them even though the
# runtimes themselves only install on machines that opted in.
#
# For ad-hoc, machine-only tools that should NOT be tracked in this repo, use
# the unmanaged ~/.config/mise/conf.d/local.toml instead.
[tools]
{{ if dig "runtimeGo" false . -}}
# renovate: datasource=golang-version depName=go
go = "1.26.5" # Latest stable
# renovate: datasource=github-tags depName=golang/tools extractVersion=^gopls/v(?<version>.+)$
"go:golang.org/x/tools/gopls" = "0.23.0" # Go language server (gopls), used by the nvim LSP
# Go dev tooling — aqua pre-built binaries, so these need no local toolchain to
# install, but they're only useful on a Go machine. Kept here (not Homebrew) so
# mise owns every Go tool: a brew `go` on PATH shadows mise's during `go:`
# builds and breaks them whenever the two versions drift apart.
# renovate: datasource=github-releases depName=golangci/golangci-lint extractVersion=^v?(?<version>\d.*)$
"aqua:golangci/golangci-lint" = "2.12.2" # Go linter aggregator
# renovate: datasource=github-releases depName=goreleaser/goreleaser extractVersion=^v?(?<version>\d.*)$
"aqua:goreleaser/goreleaser" = "2.17.1" # Go release automation
{{ end -}}
{{ if dig "runtimeJava" false . -}}
java = "temurin-21.0.10+7.0.LTS" # Eclipse Temurin 21 LTS
{{ end -}}
{{ if dig "runtimePython" false . -}}
python = "miniconda3-latest" # Pre-compiled Python via Miniconda
{{ end -}}
