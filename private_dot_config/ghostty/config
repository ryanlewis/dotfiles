# Ghostty Terminal Configuration

# ── Theme ────────────────────────────────────────────────────
# Auto light/dark switching that follows the macOS system appearance.
# Dark mode uses the built-in Ayu; light mode uses the built-in Catppuccin Latte.
# Run `ghostty +list-themes` to browse alternatives.
theme = light:Catppuccin Latte,dark:Ayu

# ── Font ─────────────────────────────────────────────────────
#font-family = IosevkaNerdFont
#font-family = "IoskeleyMono Nerd Font"
font-family = "Maple Mono NF"
font-size = 14
# Faux-bold the strokes a touch (macOS); helps text read heavier on light backgrounds.
font-thicken = true
font-feature = +liga
font-feature = +calt

# ── Window & Appearance ──────────────────────────────────────
macos-titlebar-style = transparent
macos-window-buttons = hidden
window-padding-x = 0
window-padding-y = 0
window-padding-balance = true
# Both modes run fully opaque (no background-opacity set). background-blur-radius
# only takes effect if you reintroduce transparency.
background-blur-radius = 10
window-save-state = always
macos-window-shadow = true
# Dim unfocused splits so the active pane pops. The fill defaults to the
# theme background, so dimming adapts to light/dark mode automatically.
unfocused-split-opacity = 0.75
# Mid-grey split borders, legible against both light and dark backgrounds
split-divider-color = #555555


# ── Shell ────────────────────────────────────────────────────
# Explicit zsh path; remove if zsh is your login shell
command = /bin/zsh
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# ── Cursor ───────────────────────────────────────────────────
cursor-style = bar
cursor-style-blink = false
adjust-cursor-thickness = 2

# ── Quick Terminal (hotkey window) ───────────────────────────
# keybind = global:§=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-screen = main
quick-terminal-animation-duration = 0.15
quick-terminal-autohide = true

# ── Split Panes ─────────────────────────────────────────────

# Navigate splits
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:top
keybind = cmd+alt+down=goto_split:bottom

# Resize splits
keybind = cmd+ctrl+left=resize_split:left,20
keybind = cmd+ctrl+right=resize_split:right,20
keybind = cmd+ctrl+up=resize_split:up,20
keybind = cmd+ctrl+down=resize_split:down,20

# Zoom/unzoom current split

# Equalise splits
keybind = cmd+shift+e=equalize_splits

# ── Prompt Navigation (requires shell integration) ──────────
keybind = cmd+up=jump_to_prompt:-1
keybind = cmd+down=jump_to_prompt:1

# ── Tabs ─────────────────────────────────────────────────────
# Tabs, splits and close go to herdr (see herdr's config.toml), so Ghostty lets
# these chords through instead of acting on them itself.
keybind = cmd+t=unbind
keybind = cmd+w=unbind
keybind = cmd+d=unbind
keybind = cmd+shift+d=unbind
keybind = cmd+shift+[=unbind
keybind = cmd+shift+]=unbind
keybind = cmd+g=unbind
keybind = cmd+n=unbind
keybind = cmd+p=unbind
keybind = cmd+shift+enter=unbind
keybind = cmd+1=unbind
keybind = cmd+digit_1=unbind
keybind = cmd+2=unbind
keybind = cmd+digit_2=unbind
keybind = cmd+3=unbind
keybind = cmd+digit_3=unbind
keybind = cmd+4=unbind
keybind = cmd+digit_4=unbind
keybind = cmd+5=unbind
keybind = cmd+digit_5=unbind
keybind = cmd+6=unbind
keybind = cmd+digit_6=unbind
keybind = cmd+7=unbind
keybind = cmd+digit_7=unbind
keybind = cmd+8=unbind
keybind = cmd+digit_8=unbind
keybind = cmd+9=unbind
keybind = cmd+digit_9=unbind
keybind = cmd+shift+left=previous_tab
keybind = cmd+shift+right=next_tab

# ── Clipboard ────────────────────────────────────────────────
copy-on-select = clipboard
clipboard-paste-protection = true

# ── Scrollback ───────────────────────────────────────────────
scrollback-limit = 10000000

# ── Pi / Claude Code (kitty keyboard protocol: CSI 13;2u) ────
keybind = shift+enter=text:\x1b[13;2u

# ── Modifier Keys ────────────────────────────────────────────
# Right Option sends Alt/ESC sequences (readline, herdr prefix chords).
# Left Option stays as macOS compose key — needed for # (Opt+3) on UK layout.
macos-option-as-alt = right

# ── Misc ─────────────────────────────────────────────────────
#keybind = cmd+q=unbind
confirm-close-surface = true
mouse-hide-while-typing = true
auto-update = check
focus-follows-mouse = false
