#!/usr/bin/env bash
# git-prune-merged: delete local branches whose GitHub pull request has merged.
#
# A squash or rebase merge leaves the branch "unmerged" as git sees it, so
# `git branch -d` refuses it. This deletes a branch only when GitHub says a pull
# request from that branch (in this repo, not a fork) merged, and the branch's
# local tip is already in that pull request's head, so no unpushed commit is lost.
# It skips the default branch, the current branch and any branch a worktree
# has checked out.
#
# usage: git-prune-merged [-n] [-C <repo>]
#   -n  dry run: print what would go, delete nothing
#   -C  run in <repo> instead of the current directory
set -euo pipefail

dry=0
dir=.
while getopts nC:h opt; do
  case $opt in
    n) dry=1 ;;
    C) dir=$OPTARG ;;
    h) sed -n '2,14s/^# \{0,1\}//p' "$0"; exit 0 ;;
    *) exit 2 ;;
  esac
done

cd "$dir"
git rev-parse --git-dir >/dev/null

default=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)
default=${default#origin/}
default=${default:-main}
current=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)
held=$(git worktree list --porcelain | sed -n 's#^branch refs/heads/##p')

git fetch --quiet origin

deleted=0
while read -r b; do
  [[ $b == "$default" || $b == "$current" ]] && continue
  if grep -qxF -- "$b" <<<"$held"; then
    echo "keep    $b (checked out in a worktree)"
    continue
  fi

  pr=$(gh pr list --state merged --head "$b" --limit 20 \
    --json number,headRefOid,isCrossRepository \
    --jq '[.[] | select(.isCrossRepository | not)][0] // empty | "\(.number) \(.headRefOid)"')
  [[ -z $pr ]] && continue
  read -r num head <<<"$pr"

  if ! git cat-file -e "$head^{commit}" 2>/dev/null; then
    git fetch --quiet origin "pull/$num/head" 2>/dev/null || true
  fi
  if ! git cat-file -e "$head^{commit}" 2>/dev/null; then
    echo "keep    $b (#$num merged, but its head $head can't be fetched)"
    continue
  fi

  tip=$(git rev-parse "refs/heads/$b")
  if ! git merge-base --is-ancestor "$tip" "$head"; then
    echo "keep    $b (#$num merged, but local commits are not in it)"
    continue
  fi

  if ((dry)); then
    echo "would delete $b (#$num)"
  else
    git branch --quiet -D -- "$b"
    echo "deleted $b (#$num, was ${tip:0:7})"
  fi
  deleted=$((deleted + 1))
done < <(git for-each-ref --format='%(refname:short)' refs/heads)

((deleted)) || echo "nothing to prune"
